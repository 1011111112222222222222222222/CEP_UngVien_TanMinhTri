@page "/customers"
@layout EmptyLayout
@using System.Net.Http
@using System.Net.Http.Json
@using System.Net.Http.Headers

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor

@* Tắt Prerender để tránh lỗi gọi JSRuntime/Token khi chưa lập kết nối SignalR *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Quản lý khách hàng</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <!-- TITLE -->
    <MudText Typo="Typo.h4" Class="mb-2">Quản lý khách hàng</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Quản lý thông tin khách hàng
    </MudText>

    <!-- SUCCESS ALERT -->
    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
            @SuccessMessage
        </MudAlert>
    }

    <!-- ERROR ALERT -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @ErrorMessage
        </MudAlert>
    }

    <!-- SEARCH + ADD -->
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField T="string"
                          @bind-Value="SearchText"
                          Label="Tìm kiếm"
                          Placeholder="Nhập họ tên hoặc số điện thoại"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          FullWidth="true"
                          Immediate="true"
                          @onkeydown="HandleSearchKeyDown" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="Search"
                       Disabled="IsLoading">
                Tìm kiếm
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate"
                       Disabled="IsSaving">
                Thêm mới
            </MudButton>
        </MudStack>
    </MudPaper>

    <!-- FORM -->
    @if (ShowForm)
    {
        <MudPaper Elevation="3" Class="pa-5 mb-4">
            <MudText Typo="Typo.h6" Class="mb-4">
                @(IsEditMode ? "Chỉnh sửa khách hàng" : "Thêm khách hàng")
            </MudText>

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @FormError
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="CustomerForm.Code"
                                  Label="Mã khách hàng"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập mã khách hàng" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="CustomerForm.FullName"
                                  Label="Họ và tên"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập họ tên" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="CustomerForm.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  @bind-Value="CustomerForm.Phone"
                                  Label="Số điện thoại"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="CustomerForm.DateOfBirth"
                                   Label="Ngày sinh"
                                   Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="2" Class="mt-5">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveCustomer"
                           Disabled="IsSaving">
                    @if (IsSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span>Lưu</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="CloseForm"
                           Disabled="IsSaving">
                    Hủy
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    <!-- TABLE AREA -->
    <MudPaper Elevation="2">
        <MudTable T="CustomerDto"
                  Items="@Customers"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Dense="true"
                  Loading="@IsLoading"
                  LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>STT</MudTh>
                <MudTh>Mã KH</MudTh>
                <MudTh>Họ tên</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Số điện thoại</MudTh>
                <MudTh>Ngày sinh</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="STT">@(Customers.IndexOf(context) + 1)</MudTd>
                <MudTd DataLabel="Mã KH">@context.Code</MudTd>
                <MudTd DataLabel="Họ tên">@context.FullName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.Phone</MudTd>
                <MudTd DataLabel="Ngày sinh">@(context.DateOfBirth?.ToString("dd/MM/yyyy"))</MudTd>
                <MudTd DataLabel="Thao tác">
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Title="Sửa"
                                       OnClick="@(() => Edit(context.Id))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="Xóa"
                                       OnClick="@(() => Delete(context.Id))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (!IsLoading)
                {
                    <MudText Class="pa-4">Không có dữ liệu khách hàng.</MudText>
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

</MudContainer>

@code {
    private List<CustomerDto> Customers = new();
    private string SearchText = string.Empty;

    private bool IsLoading = true;
    private bool IsSaving;
    private bool ShowForm;
    private bool IsEditMode;

    private string? ErrorMessage;
    private string? SuccessMessage;
    private string? FormError;

    private CustomerDto CustomerForm = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCustomers();
        }
    }

    private HttpClient GetApiClient()
    {
        return HttpClientFactory.CreateClient("Api");
    }

    // =========================================
    // GET ALL
    // =========================================
    private async Task LoadCustomers()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            ErrorMessage = null;

            var client = GetApiClient();
            var result = await client.GetFromJsonAsync<List<CustomerDto>>("api/customers");

            Customers = result ?? new List<CustomerDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Không tải được danh sách khách hàng: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // =========================================
    // SEARCH
    // =========================================
    private async Task Search()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            ErrorMessage = null;

            string url = string.IsNullOrWhiteSpace(SearchText)
                ? "api/customers"
                : $"api/customers?search={Uri.EscapeDataString(SearchText.Trim())}";

            var client = GetApiClient();
            var result = await client.GetFromJsonAsync<List<CustomerDto>>(url);

            Customers = result ?? new List<CustomerDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Tìm kiếm thất bại: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private void OpenCreate()
    {
        CustomerForm = new CustomerDto();
        IsEditMode = false;
        ShowForm = true;
        FormError = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    // =========================================
    // EDIT
    // =========================================
    private async Task Edit(int id)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            FormError = null;

            var client = GetApiClient();
            var customer = await client.GetFromJsonAsync<CustomerDto>($"api/customers/{id}");

            if (customer == null)
            {
                ErrorMessage = "Không tìm thấy khách hàng.";
                return;
            }

            CustomerForm = customer;
            IsEditMode = true;
            ShowForm = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Không lấy được thông tin khách hàng: {ex.Message}";
        }
    }

    // =========================================
    // SAVE (POST / PUT)
    // =========================================
    private async Task SaveCustomer()
    {
        try
        {
            FormError = null;
            ErrorMessage = null;
            SuccessMessage = null;

            if (string.IsNullOrWhiteSpace(CustomerForm.Code))
            {
                FormError = "Vui lòng nhập mã khách hàng.";
                return;
            }

            if (string.IsNullOrWhiteSpace(CustomerForm.FullName))
            {
                FormError = "Vui lòng nhập họ tên.";
                return;
            }

            IsSaving = true;

            var client = GetApiClient();
            HttpResponseMessage response;

            if (IsEditMode)
            {
                response = await client.PutAsJsonAsync($"api/customers/{CustomerForm.Id}", CustomerForm);

                if (!response.IsSuccessStatusCode)
                {
                    ErrorMessage = await GetApiError(response);
                    return;
                }

                SuccessMessage = "Cập nhật khách hàng thành công.";
            }
            else
            {
                response = await client.PostAsJsonAsync("api/customers", CustomerForm);

                if (!response.IsSuccessStatusCode)
                {
                    ErrorMessage = await GetApiError(response);
                    return;
                }

                SuccessMessage = "Thêm khách hàng thành công.";
            }

            ShowForm = false;
            CustomerForm = new CustomerDto();
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lưu khách hàng thất bại: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    // =========================================
    // DELETE
    // =========================================
    private async Task Delete(int id)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;

            var client = GetApiClient();
            var response = await client.DeleteAsync($"api/customers/{id}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await GetApiError(response);
                return;
            }

            SuccessMessage = "Xóa khách hàng thành công.";
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Xóa khách hàng thất bại: {ex.Message}";
        }
    }

    private void CloseForm()
    {
        ShowForm = false;
        FormError = null;
        CustomerForm = new CustomerDto();
    }

    private async Task<string> GetApiError(HttpResponseMessage response)
    {
        try
        {
            var message = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(message))
            {
                return message;
            }
        }
        catch { }

        return $"API trả về lỗi HTTP {(int)response.StatusCode} - {response.ReasonPhrase}";
    }
}